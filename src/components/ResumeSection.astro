---
interface Props { title: string }
const { title } = Astro.props;
---
<section class="resume-card mb-6 rounded-xl border border-slate-200 bg-white p-5 sm:p-6 dark:border-slate-800 dark:bg-slate-900 print:mb-4">
  <h2 class="mb-2 text-lg font-semibold text-slate-950 dark:text-white">{title}</h2>
  <slot />
</section>
