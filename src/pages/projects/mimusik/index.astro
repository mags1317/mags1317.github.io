---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import RequestDemo from '../../../components/RequestDemo';
import { Content } from '../../../content/mimusik.md';
---
<SiteLayout title="MiMusik Case Study – Miguel Ángel García Sepúlveda" description="Case study of MiMusik, a retired personalized music product.">
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-8">
    <a href="/projects/" class="text-blue-700 underline dark:text-blue-300">All projects</a>
    <header class="my-6">
      <p class="text-sm font-medium text-slate-600 dark:text-slate-300">Retired product</p>
      <h1 class="mt-1 text-4xl font-semibold tracking-tight">MiMusik</h1>
    </header>
    <div class="space-y-4 [&_h2]:pt-3 [&_h2]:text-2xl [&_h2]:font-semibold">
      <Content />
    </div>
    <section class="mt-8 rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 sm:p-6" aria-labelledby="demo">
      <h2 id="demo" class="text-2xl font-semibold">Request preview</h2>
      <p class="mb-4 mt-2">Try a fictional request. The preview runs in this browser and sends nothing.</p>
      <RequestDemo client:load />
    </section>
  </main>
</SiteLayout>
