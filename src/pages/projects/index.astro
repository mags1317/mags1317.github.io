---
import SiteLayout from '../../layouts/SiteLayout.astro';
---
<SiteLayout title="Projects – Miguel Ángel García Sepúlveda" description="Project case studies from Miguel Ángel García Sepúlveda.">
  <main id="main" class="mx-auto max-w-4xl px-4 py-10 sm:px-8">
    <h1 class="mb-6 text-4xl font-semibold tracking-tight">Projects</h1>
    <article class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
      <p class="text-sm font-medium text-slate-600 dark:text-slate-300">Retired product</p>
      <h2 class="mt-1 text-2xl font-semibold"><a href="/projects/mimusik/" class="underline">MiMusik</a></h2>
      <p class="mt-2">A bilingual personalized music website with an audio player and WhatsApp-based order intake.</p>
    </article>
  </main>
</SiteLayout>
